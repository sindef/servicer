FROM golang:1.27.1-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS builder
ARG HELM_VERSION=v4.2.0
ARG TARGETOS=linux
ARG TARGETARCH=amd64

# go.mod requires a toolchain newer than the pinned builder image, so allow Go
# to fetch the patched toolchain instead of failing with GOTOOLCHAIN=local.
ENV GOTOOLCHAIN=auto

WORKDIR /build

COPY go.mod go.sum ./
# The module proxy occasionally drops large module zips with an HTTP/2 stream
# error, which would fail an otherwise healthy build, so retry a bounded number
# of times. go.sum verification is unchanged: every attempt re-reads and
# verifies the same modules.
RUN attempt=1; \
    until go mod download; do \
      if [ "${attempt}" -ge 3 ]; then \
        echo "go mod download failed after ${attempt} attempts" >&2; \
        exit 1; \
      fi; \
      echo "go mod download failed (attempt ${attempt}); retrying in 15s" >&2; \
      attempt=$((attempt + 1)); \
      sleep 15; \
    done; \
    echo "downloaded Go modules in ${attempt} attempt(s)"

COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /manager ./cmd/manager
RUN apk add --no-cache curl tar && \
    HELM_TAR=/tmp/helm-${HELM_VERSION}-linux-${TARGETARCH}.tar.gz && \
    curl -fsSL "https://get.helm.sh/helm-${HELM_VERSION}-linux-${TARGETARCH}.tar.gz" -o "$HELM_TAR" && \
    curl -fsSL "https://get.helm.sh/helm-${HELM_VERSION}-linux-${TARGETARCH}.tar.gz.sha256sum" -o /tmp/helm.tgz.sha256sum && \
    cd /tmp && grep "helm-${HELM_VERSION}-linux-${TARGETARCH}.tar.gz" helm.tgz.sha256sum | sha256sum -c - && \
    tar -xzf "$HELM_TAR" -C /tmp && \
    mv /tmp/linux-${TARGETARCH}/helm /helm

# ---- runtime ----
FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

RUN apk add --no-cache ca-certificates git openssh-client && \
    addgroup -S servicer && \
    adduser -S -G servicer -u 65532 servicer

COPY --from=builder /manager /manager
COPY --from=builder /helm /helm

EXPOSE 8080 8081

USER 65532:65532
ENTRYPOINT ["/manager"]
