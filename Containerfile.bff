FROM golang:1.26.5-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS builder
ARG TARGETOS=linux
ARG TARGETARCH=amd64

# go.mod requires a toolchain newer than the pinned builder image, so allow Go
# to fetch the patched toolchain instead of failing with GOTOOLCHAIN=local.
ENV GOTOOLCHAIN=auto

WORKDIR /build

# Fetch deps first (layer cache)
COPY go.mod go.sum ./
RUN go mod download

# Build static binary
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -trimpath -ldflags="-s -w" -o /bff ./cmd/bff

# ---- runtime ----
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

COPY --from=builder /bff /bff

EXPOSE 8090 8443
ENTRYPOINT ["/bff"]
